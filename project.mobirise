          },
          "_name": "article12",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article12\" group=\"Article\">    \n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#1d1a1a\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-4 mt-0\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>ABOUT US</b></h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\">The storytelling magic of photos\n                </h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Founded in <b>2002</b>, <b>Lex &amp; Partners Law Firm</b> has built a strong reputation for trust, transparency, and outstanding legal service.\n<br>Over the past two decades, we have represented clients across Malaysia and internationally, offering solutions that balance\n<br>legal precision with practical results.&nbsp;<br><br><br><b>Our approach is simple:</b><br>We listen carefully, analyze deeply, and act decisively. With a diverse team of legal professionals, we specialize <br>in both corporate and personal legal matters, ensuring that each case receives personalized attention and care.\n<br>\n<br><b>Our Mission\n<br></b>To provide professional, ethical and effective legal services <br>that uphold justice and serve the best interests of our clients.\n<br>\n<br><b>Our Vision\n<br></b>To be a trusted law firm recognized for integrity,\n<br>innovation and excellence in legal practice.<br></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uZKqokHAlF",
          "_anchor": "article12-g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#000000"
            },
            ".mbr-section-title": {
              "color": "#000000"
            }
          },
          "_name": "article12",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article12\" group=\"Article\">    \n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-4 mt-0\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>PRACTICE AREAS</b></h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\">The storytelling magic of photos\n                </h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\"><b>At Lex &amp; Partners</b>, our expertise spans across multiple legal disciplines :\n<br>\n<br>\n<br><b>1. Corporate &amp; Commercial Law</b><b><br></b>&nbsp; &nbsp; We assist companies in drafting, reviewing and negotiating <br>&nbsp; &nbsp; commercial agreements, mergers, acquisitions and compliance issues.\n<br>&nbsp; &nbsp; Our goal is to protect your business interests while ensuring long-term growth.\n<br>\n<br>\n<br><b>2. Civil &amp; Criminal Litigation</b><b><br></b>&nbsp; &nbsp; Our litigation team represents clients in civil disputes,\n<br>&nbsp; &nbsp; contract breaches, personal injury claims, and criminal defense.\n<br>&nbsp; &nbsp; We focus on strong case strategy, thorough research and persuasive argumentation.\n<br>\n<br>\n<br><b>3. Real Estate &amp; Property Law</b><b><br></b>&nbsp; &nbsp; From property transactions to tenancy disputes, our firm\n<br>&nbsp; &nbsp; provides reliable legal support to buyers, sellers and developers.\n<br>\n<br>\n<br><b>4. Family &amp; Divorce Law</b><b><br></b>&nbsp; &nbsp; We handle sensitive family matters with care, confidentiality\n<br>&nbsp; &nbsp; and respect — including divorce, child custody and asset division.\n<br>\n<br>\n<br><b>5. Employment Law</b><b><br></b>&nbsp; &nbsp; We guide both employers and employees through\n<br>&nbsp; &nbsp; workplace disputes, unfair dismissals, and contractual issues.\n<br>\n<br>\n<br><b>6. Intellectual Property (IP) Law</b><b><br></b>&nbsp; &nbsp; Our IP team protects your creative assets — trademarks, <br>&nbsp; &nbsp; copyrights, and patents — from infringement and misuse.</p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uZKnmWBHOl",
          "_anchor": "article12-f",
          "_protectedParams": [],
          "_global": false,
